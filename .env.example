# YoLink REST API Credentials
# Get these from https://www.yosmart.com/
YOLINK_CLIENT_ID=your_client_id_here
YOLINK_CLIENT_SECRET=your_client_secret_here

# YoLink MQTT / UAC Credentials (for tank sensors)
# Universal Access Credentials from YoLink developer portal
YOLINK_UAC_ID=your_uac_id_here
YOLINK_UAC_SECRET=your_uac_secret_here
YOLINK_HOME_ID=your_home_id_here

# Google Sheets (for later)
GOOGLE_CREDENTIALS={"type":"service_account",...}
CHLORINE_SHEET_ID=your_sheet_id
PRODUCTION_SHEET_ID=your_sheet_id

# Twilio SMS Configuration
# Sign up at https://www.twilio.com/ — get a phone number (~$1.15/mo)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Outbound + inbound number. The approved local BPWS line, (206) 350-4374.
TWILIO_PHONE_NUMBER=+12063504374
ADMIN_PHONE_NUMBER=+15551234567

# ── Inbound SMS (auto-reply + forward to board) ──
# Comma-separated E.164 cell numbers that receive forwarded customer texts.
# These are the board members who can respond to a 2am leak. Kept private
# (separate from the public roster on the contact page).
BOARD_SMS_RECIPIENTS=+12065550101,+12065550102,+12065550103
# Set to "false" ONLY for local webhook testing to skip Twilio signature
# validation. Leave unset (validation on) in production.
# TWILIO_VALIDATE_SIGNATURE=false

# ── Public contact/board website ──
# Hostname(s) that serve the public website (public/site/), comma-separated.
# Defaults to the apex + www + new. staging subdomain when unset.
PUBLIC_SITE_HOSTNAME=beulahparkws.org,www.beulahparkws.org,new.beulahparkws.org

# Database (SQLite file path)
DB_PATH=./data/alerts.db

# Google OAuth (dashboard login)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URIs: https://your-app.fly.dev/auth/google/callback
#   (also add http://localhost:3000/auth/google/callback for local dev)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret

# Resend (branded email sends — customer broadcasts + board alerts)
# Sign up at https://resend.com, verify beulahparkws.org for DKIM
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notices@beulahparkws.org
RESEND_FROM_NAME=Beulah Park Water System

# Absolute dashboard URL (used for logo in emails, links back to dashboard)
DASHBOARD_BASE_URL=https://dashboard.beulahparkws.org

# Chlorine form → board alerts (replaces the Google Apps Script mail triggers)
# Comma-separated list of recipient email addresses.
CHLORINE_ALERT_RECIPIENTS=board@beulahparkws.org
# Shared secret between the Apps Script onFormSubmit trigger and this server.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHLORINE_WEBHOOK_SECRET=your_random_webhook_secret
# Set to "true" to pause the hourly "chlorination report not updated in 24h" alert.
# Submission emails are unaffected.
CHLORINE_STALE_ALERT_DISABLED=false

# Server
PORT=3000
